TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Buyruq bera oladigan Telegram user ID(lar), vergul bilan. Shaxsiy chatda (CHAT_ID musbat)
# shart emas — chat egasi avtomatik. GURUH chatda MAJBURIY: aks holda hech kimga javob
# berilmaydi (har a'zo /pm_push, /pm_set... ishlata olmasin). ID: botga yozing — rad
# xabarida ko'rinadi, yoki @userinfobot.
# TELEGRAM_OWNER_IDS=

# --- claude -p auth ---
# Mac: subscription login yetadi (hech narsa kerak emas).
# Server (Max plan): Mac'da `claude setup-token` → tokenni shu yerga (1 yil yashaydi):
# CLAUDE_CODE_OAUTH_TOKEN=
# Server API-key fallback: FAQAT .env.server faylda! (Mac .env'ga qo'yilsa
# ANTHROPIC_API_KEY OAuth'dan ustun bo'lib Mac ham API-billing'ga o'tadi):
# ANTHROPIC_API_KEY=

# --- ixtiyoriy ---
# CLAUDE_BIN=/opt/homebrew/bin/claude
# CLAUDE_MODEL=fable
# CHROME_BIN=/usr/bin/chromium          # avto-topilmasa
# CHROME_FLAGS=--no-sandbox             # Linux'da sandbox ishlamasa (deploy.sh o'zi qo'shadi)
