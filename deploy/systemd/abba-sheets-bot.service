# Q&A bot listener (launchd com.abba.sheets-bot KeepAlive ekvivalenti).
# Restart=always — jarayon o'lsa 10s ichida qayta ko'tariladi.
[Unit]
Description=Abba Sheets Q&A bot (Telegram listener)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=abba
WorkingDirectory=/home/abba/abba-sheets-agent
ExecStart=/bin/bash /home/abba/abba-sheets-agent/bot_run.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
