<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.abba.sheets-agent</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/ismoilxon/abba-sheets-agent/run.sh</string>
    </array>

    <!-- Har kuni 09:00. Mac shu paytda uxlab yotgan bo'lsa, launchd
         o'tkazib yuborilgan ishga tushirishni uyg'onganda bir marta bajaradi. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>9</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/ismoilxon/abba-sheets-agent/data/logs/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ismoilxon/abba-sheets-agent/data/logs/launchd.log</string>
</dict>
</plist>
